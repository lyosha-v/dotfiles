[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[user]
	name = Lyosha Verkholantcev
	email = lyosha@granola.so
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIEzczfvVF132fCr1+p7iUrKqjBGVPUJP/XgLcITS+e/

[alias]
	lg = "log --graph --format='format:%w(80)%Cgreen%h%Creset %Cred%d%Creset%n%s%n%Cgreen%an%Creset (%ar)%n'"
	co = checkout
	ci = commit
	st = status
	br = branch
	dt = difftool

[diff]
	tool = vimdiff

[color]
	ui = auto

[core]
	editor = vim

[push]
	default = current

[merge]
	tool = vimdiff
