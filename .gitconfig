[user]
	name = Lyosha Verkholantcev
	email = lyosha@granola.so
	signingkey = ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIIEzczfvVF132fCr1+p7iUrKqjBGVPUJP/XgLcITS+e/

# Commit signing through the 1Password SSH agent. Every commit prompts for
# approval, so anything scripted needs `-c commit.gpgsign=false`.
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true

[alias]
	lg = "log --graph --format='format:%w(80)%Cgreen%h%Creset %Cred%d%Creset%n%s%n%Cgreen%an%Creset (%ar)%n'"
	co = checkout
	ci = commit
	st = status
	br = branch
	dt = difftool

[core]
	editor = nvim
	pager = delta
	fsmonitor = true
	untrackedCache = true

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
	# Light is the fallback when nothing sets DELTA_FEATURES -- a dark theme on a
	# light terminal is unreadable, whereas the reverse merely looks flat.
	features = light-mode

# .zshrc exports DELTA_FEATURES=+dark-mode or +light-mode from the macOS
# appearance, the same signal .vimrc uses. An explicit syntax-theme is required:
# delta's dark/light setting only controls its own +/- chrome, and will happily
# paint a dark syntax theme onto a light background.
[delta "light-mode"]
	light = true
	syntax-theme = Catppuccin Latte

[delta "dark-mode"]
	dark = true
	syntax-theme = Catppuccin Mocha

[diff]
	tool = vimdiff
	# Noticeably more readable than the default on refactors.
	algorithm = histogram
	# Distinguishes moved lines from genuinely added and removed ones.
	colorMoved = default

[merge]
	tool = vimdiff
	# Shows the common ancestor alongside both sides, which makes a conflict far
	# easier to reason about than the default two-way view.
	conflictStyle = zdiff3

[rerere]
	# Records how a conflict was resolved and replays it when the same one comes
	# back, which it does constantly over a long-lived rebase.
	enabled = true

[rebase]
	autosquash = true
	autostash = true

[fetch]
	prune = true

[pull]
	ff = only

[push]
	default = current
	autoSetupRemote = true

[init]
	defaultBranch = main

[color]
	ui = auto
